OPENAI_API_KEY=""
OKF_BUNDLE_PATH="/okf-bundle-nl2sql"

CLAUDE_API_KEY=""

ORCHESTRATOR_MAX_VALIDATION_ATTEMPTS=4
ORCHESTRATOR_VALIDATION_SCORE_THRESHOLD=90
ORCHESTRATOR_STAGE_RETRY_ATTEMPTS=2

OPENAI_MAX_CONCURRENCY=5
OPENAI_RPM=60
ANTHROPIC_MAX_CONCURRENCY=5
ANTHROPIC_RPM=60
RATE_LIMITER_ACQUIRE_TIMEOUT_SECONDS=30

#RATE_LIMITER_ACQUIRE_TIMEOUT_SECONDS:How long a call is willing to wait for a concurrency slot or a rate-limit token before giving up. Shared by both limiters. If neither becomes available within 30 seconds, the call raises TimeoutError instead of hanging indefinitely 
# OPENAI_RPM:no more than 60 OpenAI calls happen in any given minute — protecting your actual OpenAI/Anthropic account limits from being exceeded

#OPENAI_MAX_CONCURRENCY:if 10 requests hit your API at once, at most 5 of their OpenAI calls run simultaneously (the other 5 queue)

API_HOST=0.0.0.0
API_PORT=8089